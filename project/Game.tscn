[sub_resource type="Shader" id="3"]
code = "shader_type canvas_item;

uniform float width = 384.0;
uniform float height = 240.0;
uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_nearest;

void fragment() {
	vec2 uv = SCREEN_UV;
	
	vec3 c = textureLod(screen_texture, uv, 0.0).rgb;
	
	vec2 tex_uv = UV;
	
	int i_x = int(floor(mod(floor(tex_uv.x * float(width)), 4.0)));
	int i_y = int(floor(mod(floor(tex_uv.y * float(height)), 4.0)));
	
	mat4 m;
	m[0][0] = 0.0 / 16.0;
	m[0][1] = 8.0 / 16.0;
	m[0][2] = 2.0 / 16.0;
	m[0][3] = 10.0 / 16.0;
	m[1][0] = 13.0 / 16.0;
	m[1][1] = 4.0 / 16.0;
	m[1][2] = 14.0 / 16.0;
	m[1][3] = 6.0 / 16.0;
	m[2][0] = 3.0 / 16.0;
	m[2][1] = 11.0 / 16.0;
	m[2][2] = 1.0 / 16.0;
	m[2][3] = 9.0 / 16.0;
	m[3][0] = 12.0 / 16.0;
	m[3][1] = 7.0 / 16.0;
	m[3][2] = 15.0 / 16.0;
	m[3][3] = 5.0 / 16.0;
	
	float arr[16];
	arr[0] = 0.0 / 16.0;
	arr[1] = 8.0 / 16.0;
	arr[2] = 2.0 / 16.0;
	arr[3] = 10.0 / 16.0;
	arr[4] = 14.0 / 16.0;
	arr[5] = 4.0 / 16.0;
	arr[6] = 12.0 / 16.0;
	arr[7] = 6.0 / 16.0;
	arr[8] = 3.0 / 16.0;
	arr[9] = 11.0 / 16.0;
	arr[10] = 1.0 / 16.0;
	arr[11] = 9.0 / 16.0;
	arr[12] = 13.0 / 16.0;
	arr[13] = 7.0 / 16.0;
	arr[14] = 15.0 / 16.0;
	arr[15] = 5.0 / 16.0;
	
	float value = arr[i_x + 4*i_y];
	
	if (c.r >= value *0.98 + 0.02) {
		c = vec3(1.0);
	} else {
		c = vec3(0.0);
	}
	
	COLOR =  vec4(c, 1.0);
}
"

